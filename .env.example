# Server port (3000 in dev / AI Studio; on Beget VPS use 3011 so it does not collide with 3010)
PORT=3000

# SQLite database path
DB_PATH=./data/cards.db

# Admin password (optional: if both ADMIN_PASSWORD and ADMIN_PASSWORD_HASH are empty,
# the first-run setup form in the UI creates a scrypt hash in SQLite)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Public application URL
APP_URL="https://contact.magmahome.ru"
